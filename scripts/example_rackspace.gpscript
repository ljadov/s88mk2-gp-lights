// Les zones s'affichent toutes seules d'apres les blocs MIDI In (avec handle).
// Ce script n'est utile que pour ajuster. Noms de couleurs : voir la charte du README.

On Activate
   // Forcer une couleur pour un bloc precis (handle "Basse") :
   KK_SetZoneColor("Basse", KK_ColorByName("bleu clair"))

   // Ou passer en mode manuel :
   // KK_SetAutoZones(false)
   // KK_Clear()
   // KK_SetRangeByName(21, 47, "bleu")
   // KK_SetRangeByName(48, 108, "vert sombre")
   // KK_SetKeyByName(48, "blanc clair")
End
